{
  "info": {
    "name": "CampusRate",
    "description": "Collection d'essais manuels de l'API CampusRate (TP2, 420-514). Couvre la creation et la consultation, la modification, la suppression, le conflit 409, la validation (propriete absente, valeur invalide, propriete inconnue, champ controle par le serveur, injection NoSQL), le 415 et la persistance dans MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "placeId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    },
    {
      "key": "placeToDeleteId",
      "value": ""
    },
    {
      "key": "placeConflictId",
      "value": ""
    },
    {
      "key": "reviewConflictId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Places",
      "item": [
        {
          "name": "1. Creer un endroit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/places",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "places"
              ]
            },
            "description": "Scenario 1 du TP2 : creation d'une ressource valide. Attendu : 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bibliotheque principale\",\n  \"description\": \"Espace calme avec prises.\",\n  \"category\": \"LIBRARY\",\n  \"address\": \"Pavillon A, local A-210\",\n  \"services\": [\n    \"WIFI\",\n    \"POWER_OUTLETS\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('placeId', data.id);",
                  "pm.test('id genere par le serveur', function () { pm.expect(data.id).to.match(/^plc_/); });",
                  "pm.test('aucun _id expose', function () { pm.expect(data).to.not.have.property('_id'); });",
                  "pm.test('averageRating null et reviewCount 0', function () {",
                  "  pm.expect(data.averageRating).to.be.null;",
                  "  pm.expect(data.reviewCount).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Consulter l'endroit cree",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/places/{{placeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "places",
                "{{placeId}}"
              ]
            },
            "description": "Scenario 2 du TP2 : consultation d'une ressource persistee dans MongoDB. Attendu : 200."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Modifier partiellement l'endroit",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/places/{{placeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "places",
                "{{placeId}}"
              ]
            },
            "description": "Scenario 7 du TP2 : modification valide. Attendu : 200, updatedAt change.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"TEMPORARILY_CLOSED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('status modifie', function () { pm.expect(data.status).to.eql('TEMPORARILY_CLOSED'); });",
                  "pm.test('updatedAt different de createdAt', function () { pm.expect(data.updatedAt).to.not.eql(data.createdAt); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Filtrer par categorie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/places?category=LIBRARY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "places"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "LIBRARY"
                }
              ]
            },
            "description": "Filtre exact sur la categorie. Attendu : 200, uniquement des LIBRARY."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('toutes les places sont LIBRARY', function () {",
                  "  data.data.forEach((place) => pm.expect(place.category).to.eql('LIBRARY'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5. Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/places?page=1&limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "places"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            },
            "description": "Attendu : 200, au plus 2 elements, pagination presente."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('limit respecte', function () { pm.expect(data.data.length).to.be.at.most(2); });",
                  "pm.test('metadonnees de pagination', function () {",
                  "  ['page', 'limit', 'totalItems', 'totalPages'].forEach((key) => pm.expect(data.pagination).to.have.property(key));",
                  "});"
